# Copy this file to .env and fill in real values. Never commit the real .env.

# Service account JSON key with access to Sheets, Drive, and Cloud TTS
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# The Google Sheet acting as the content queue
SHEET_ID=your_google_sheet_id_here
SHEET_TAB_NAME=Queue

# Google AI Studio (Gemini API) — free tier, no card required
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Instagram Graph API
IG_BUSINESS_ACCOUNT_ID=your_ig_business_account_id
IG_ACCESS_TOKEN=your_long_lived_access_token

# Google Drive folder where generated voiceover files get uploaded
DRIVE_FOLDER_ID=your_drive_folder_id_here

# Text required somewhere in every caption before it's allowed to publish
AI_DISCLOSURE_TEXT=This account uses AI-generated content.

# Number of images Pollinations.AI generates per row (free, no API key needed).
# Only applies when asset_type=image. Default: 4
IMAGE_COUNT=4

# Optional — YouTube Data API v3 key for trending-video signal in idea generation.
# Enable "YouTube Data API v3" in your Google Cloud project (same project as
# Sheets/Drive), then create an API key restricted to that API.
# 10,000 quota units/day free; ~100 units per content pillar per run.
# Leave blank to skip YouTube signal (Gemini web grounding still runs).
YOUTUBE_API_KEY=